    "lineHeight": {
      "tight": 1.2,
      "snug": 1.3,
      "normal": 1.4,
      "relaxed": 1.6,
      "loose": 1.7
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
