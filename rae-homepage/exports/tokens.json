  "transitions": {
    "fast": "100ms",
    "normal": "200ms",
    "slow": "300ms",
    "slower": "600ms"
  },
  "easing": {
    "linear": "cubic-bezier(0, 0, 1, 1)",
    "in": "cubic-bezier(0.4, 0, 1, 1)",
    "out": "cubic-bezier(0, 0, 0.2, 1)",
    "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "breakpoints": {
    "mobile": "320px",
    "tablet": "640px",
    "desktop": "1024px",
    "wide": "1280px"
